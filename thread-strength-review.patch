+writeLines(c(paste0("generated : ", format(Sys.time(), "%Y-%m-%d %H:%M:%S")),
+             paste0("input     : 03_analyses/thread-summary.xlsx"),
+             paste0("threads in models : ", nrow(dat)),
+             paste0("mussels in models : ", n_distinct(dat$mussel)),
+             paste0("paired animals    : ", nrow(paired))),
+           file.path(out_dir, "RUN_provenance.txt"))
+print("done")

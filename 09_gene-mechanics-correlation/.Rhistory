for (i in 1:6) {
if (all(dir.exists(file.path(d, c("differential-expression", "thread-strength"))))) return(d)
d <- dirname(d)
}
stop("Repo root not found: need a parent containing differential-expression/ and thread-strength/.")
}
repo_root   <- find_repo_root()
DE_DIR      <- file.path(repo_root, "differential-expression")
THREAD_FILE <- file.path(repo_root, "thread-strength", "03_analyses", "thread-summary.xlsx")
RAW_FILE    <- file.path(repo_root, "thread-strength", "03_analyses", "extract-tensometer-data",
"thread-summary-raw-output.xlsx")   # every extracted trace, script 1
GM_DIR      <- file.path(repo_root, "gene-mechanics-correlation", "03_analyses", "gene_mechanics")  # script 20 outputs
OUT_DIR     <- file.path(repo_root, "gene-mechanics-correlation", "03_analyses", "expr_tables")
dir.create(OUT_DIR, showWarnings = FALSE, recursive = TRUE)
## canonical 3-digit trossulus mussel tag, shared across the chain
norm_id <- function(x) {
x   <- as.character(x)
pre <- gsub("[0-9].*$", "", x)
num <- suppressWarnings(as.integer(gsub("[^0-9].*$", "", gsub("^[^0-9]+", "", x))))
ifelse(is.na(num), NA_character_, sprintf("%s%03d", pre, num))
}
## Read the curated thread table under either the current or the older column names, and
## make sure `phase` exists (lab / pre / post). Mirrors script 20; kept local so this script
## stays independently runnable.
read_thread_summary <- function(path) {
d <- readxl::read_excel(path, sheet = "data")
ren <- c(mussel_ID = "mussel", thread_num = "thread", treatment = "thread_trt")
for (from in names(ren)) {
to <- ren[[from]]
if (from %in% names(d) && !to %in% names(d)) names(d)[names(d) == from] <- to
}
need <- c("mussel", "thread_trt", "mussel_trt", "max_force", "pad_area")
if (length(setdiff(need, names(d))) > 0)
stop("thread-summary.xlsx is missing: ", paste(setdiff(need, names(d)), collapse = ", "))
if (!"phase" %in% names(d))
d$phase <- dplyr::case_when(d$thread_trt == "lab_control" ~ "lab",
d$thread_trt == "baseline"    ~ "pre",
TRUE                          ~ "post")
if (!"max_displacement" %in% names(d)) d$max_displacement <- NA_real_
d %>% mutate(mussel = norm_id(mussel), adhesion_kpa = max_force / pad_area * 1000) %>%
filter(!is.na(adhesion_kpa))
}
## RNA samples present (chosen-tissue + the other, to know what was sequenced)
cm_head <- read.csv(file.path(DE_DIR, "02_data", "gene_count_matrix_clean.csv"),
nrows = 1, check.names = FALSE)
rna_cols <- colnames(cm_head)[-1]
rna_tab <- tibble(col = rna_cols) %>%
mutate(mussel = str_extract(col, "^T\\d+"),
tissue = str_extract(col, "(FX|F|G)$")) %>%
filter(!is.na(mussel)) %>%
group_by(mussel) %>% summarise(rna_tissues = paste(sort(unique(tissue)), collapse = ""),
.groups = "drop")
## RNA treatment/day (foot treatmentinfo is authoritative; same animal => same treatment)
ti <- read.table(file.path(DE_DIR, "03_analyses", "DEG_lists", "Foot", "F_treatmentinfo.csv"),
header = TRUE, sep = " ") %>%
mutate(mussel = sub("F$", "", `...1`)) %>% distinct(mussel, treatment, day)
## curated summary presence (day-3 threads and pre-exposure baselines)
thr_raw <- read_thread_summary(THREAD_FILE) %>% mutate(mn = mussel)
post_n <- thr_raw %>% dplyr::filter(phase == "post") %>% dplyr::count(mn, name = "in_summary_post")
base_n <- thr_raw %>% dplyr::filter(phase == "pre")  %>% dplyr::count(mn, name = "in_summary_base")
## every extracted trace (script 1), by mussel and phase
if (!file.exists(RAW_FILE))
stop("Extraction output not found:\n  ", RAW_FILE, "\nRun thread-strength script 1.")
raw_all <- read_excel(RAW_FILE, sheet = "data") %>% mutate(mn = norm_id(mussel))
raw_post <- raw_all %>% dplyr::filter(phase == "post") %>% dplyr::count(mn, name = "raw_post")
raw_pre  <- raw_all %>% dplyr::filter(phase == "pre")  %>% dplyr::count(mn, name = "raw_pre")
manifest <- rna_tab %>%
mutate(mn = norm_id(mussel)) %>%
left_join(ti, by = "mussel") %>%
left_join(post_n, by = "mn") %>% left_join(base_n, by = "mn") %>%
left_join(raw_post, by = "mn") %>% left_join(raw_pre, by = "mn") %>%
mutate(across(c(in_summary_post, in_summary_base, raw_post, raw_pre), ~replace_na(., 0)),
poststress_missing = raw_post > 0 & in_summary_post == 0,   # extracted but not curated
baseline_missing   = raw_pre  > 0 & in_summary_base == 0,
no_post_trace      = !is.na(day) & day == 3 & raw_post == 0) %>% # sequenced at day 3, never pulled
arrange(treatment, mn)
write_csv(manifest, file.path(OUT_DIR, "rna_thread_manifest.csv"))
cat("RNA-sequenced mussels with post-stress thread data, by treatment:\n")
manifest %>% filter(in_summary_post > 0) %>%
group_by(treatment) %>% summarise(mussels = paste(mussel, collapse = ", "), .groups="drop") %>%
as.data.frame() %>% print()
cat("\nRNA-sequenced at day 3 with NO day-3 thread in the curated summary:\n")
manifest %>% filter(!is.na(day), day == 3, in_summary_post == 0) %>%
select(mussel, treatment, rna_tissues, raw_post, no_post_trace) %>% as.data.frame() %>% print()
cat("\nExtracted (script 1) but not in the curated summary (curation gap):\n")
manifest %>% filter(poststress_missing | baseline_missing) %>%
select(mussel, treatment, rna_tissues, raw_post, in_summary_post, raw_pre, in_summary_base) %>%
as.data.frame() %>% print()
if (USE_RAW_THREAD_SET) {
thread_mussels <- manifest %>% filter(raw_post > 0 | raw_pre > 0) %>% pull(mussel)
} else {
thread_mussels <- unique(thr_raw$mussel)            # present in the curated summary
}
samples_wanted <- paste0(thread_mussels, TISSUE)
## per-mussel thread mechanics (day-3 means, all four arms) for cross-reference
mech <- thr_raw %>%
filter(phase == "post") %>%
group_by(mussel, treatment = mussel_trt) %>%
summarise(n_plaques        = n(),
max_force        = mean(max_force,        na.rm = TRUE),
pad_area         = mean(pad_area,         na.rm = TRUE),
adhesion_kpa     = mean(adhesion_kpa,     na.rm = TRUE),
max_displacement = mean(max_displacement, na.rm = TRUE), .groups = "drop")
cm <- read.csv(file.path(DE_DIR, "02_data", "gene_count_matrix_clean.csv"),
row.names = 1, check.names = FALSE)
tissue_cols <- if (TISSUE == "F") grep("F$", colnames(cm), value = TRUE) else
grep("G$", colnames(cm), value = TRUE)   # F$ excludes FX
cm_t <- cm[, tissue_cols, drop = FALSE]
dds <- DESeqDataSetFromMatrix(round(as.matrix(cm_t)),
DataFrame(row.names = colnames(cm_t)), design = ~ 1)
dds <- dds[rowSums(counts(dds)) > 0, ]
vmat <- assay(vst(dds, blind = TRUE))
rownames(vmat) <- sub("^gene-", "", sub(".*\\|", "", sub("^gene-", "", rownames(vmat))))
samples_have <- intersect(samples_wanted, colnames(vmat))
cat("Thread-having mussels:", length(thread_mussels),
"| with", TISSUE, "expression:", length(samples_have), "\n")
## annotation map: read script 20's handoff (one source of truth across the chain)
am_path <- file.path(GM_DIR, "annotation_map.csv")
if (!file.exists(am_path))
stop("annotation_map.csv not found in ", GM_DIR, " - run script 20 first.")
annot <- read_csv(am_path, show_col_types = FALSE)
find_sig <- function(tcode) {                       # locate the siggene file for this contrast
d <- file.path(DE_DIR, "03_analyses", "DEG_lists", ifelse(TISSUE == "F", "Foot", "Gill"))
f <- list.files(d, pattern = sprintf("^%s%s_TC_siggene.*\\.csv$", TISSUE, tcode),
full.names = TRUE)
if (!length(f)) return(NULL)
read.table(f[1], header = TRUE, sep = " ")
}
## sample column order: chosen contrast animals first, then others, by treatment
mussel_trt <- manifest %>% select(mussel, treatment) %>% deframe()
order_samples <- function(tcode) {
s_mussel <- sub(paste0(TISSUE, "$"), "", samples_have)
ord <- tibble(sample = samples_have, mussel = s_mussel,
trt = mussel_trt[s_mussel]) %>%
mutate(trt = replace_na(trt, "control"),
pri = ifelse(trt == tcode, 0, 1)) %>%
arrange(pri, trt, mussel)
ord$sample
}
build_table <- function(tcode) {
sg <- find_sig(tcode); if (is.null(sg)) { message("no siggene for ", tcode); return(NULL) }
gcol <- grep("gene", names(sg), ignore.case = TRUE, value = TRUE)[1]
sg <- sg %>%
mutate(LOC_ID = sub("^gene-", "", sub(".*\\|", "", sub("^gene-", "", .data[[gcol]]))))
if (SIG_ONLY && "padj" %in% names(sg)) sg <- filter(sg, padj < 0.05)
sg <- sg %>% filter(LOC_ID %in% rownames(vmat)) %>%
arrange(desc(log2FoldChange))
top <- bind_rows(
head(sg, N_TOP) %>% mutate(direction = "up"),
tail(sg, N_TOP) %>% mutate(direction = "down"))
cols <- order_samples(tcode)
expr <- vmat[top$LOC_ID, cols, drop = FALSE]
out <- top %>%
left_join(annot, by = "LOC_ID") %>%
transmute(direction, LOC_ID, protein_name,
log2FoldChange = round(log2FoldChange, 3),
padj = signif(padj, 3)) %>%
bind_cols(as.data.frame(round(expr, 3)))
write_csv(out, file.path(OUT_DIR, sprintf("top%d_updown_%s_%s.csv", N_TOP, TISSUE, tcode)))
out
}
tables <- set_names(TREATMENTS) %>% map(build_table)
cat("Wrote", sum(!map_lgl(tables, is.null)), "expression tables to", OUT_DIR, "\n")
## companion: per-sample metadata + thread mechanics (one row per thread-having mussel)
sample_meta <- tibble(sample = samples_have,
mussel = sub(paste0(TISSUE, "$"), "", samples_have)) %>%
left_join(manifest %>% select(mussel, rna_treatment = treatment, rna_day = day), by = "mussel") %>%
left_join(mech, by = "mussel") %>%
arrange(rna_treatment, mussel)
write_csv(sample_meta, file.path(OUT_DIR, sprintf("sample_metadata_%s.csv", TISSUE)))
cat("\nExample - top up/down for", TREATMENTS[1], "(first few columns):\n")
if (!is.null(tables[[1]]))
tables[[1]] %>% select(direction, protein_name, log2FoldChange, padj) %>%
group_by(direction) %>% slice_head(n = 5) %>% ungroup() %>% as.data.frame() %>% print()
cat("
**Outputs (in ", OUT_DIR, "):**
- `rna_thread_manifest.csv` - every sequenced mussel: RNA tissues, treatment/day, curated
summary presence (day-3 & baseline), extracted-trace counts by phase, and the
`poststress_missing` / `baseline_missing` (extracted but not curated) and `no_post_trace`
(sequenced at day 3 but never pulled) flags.
- `top25_updown_<tissue>_<treatment>.csv` - 25 up + 25 down DEGs (by LFC) with LFC, padj,
direction, and VST expression across all thread-having mussels.
- `sample_metadata_<tissue>.csv` - per mussel: treatment, day, and post-stress thread
mechanics, to cross-reference against the expression columns above (match on mussel ID;
expression column `T046F` -> mussel `T046`).
**Caveats:**
- `SIG_ONLY = TRUE` ranks within padj<0.05 DEGs; for contrasts with few DEGs (e.g. foot-OA,
~80 genes) you may get fewer than 25 in a direction. Set FALSE to rank all expressed genes.
- With `USE_RAW_THREAD_SET = FALSE`, columns are limited to mussels in the curated summary;
TRUE includes every animal with an extracted trace, whether or not it has been curated.
- Genes are ranked by fold change, not by association with mechanics; this is a descriptive
cross-reference table, not a test.
")
knitr::opts_chunk$set(echo = TRUE, message = FALSE, warning = FALSE)
suppressPackageStartupMessages({ library(DESeq2); library(readxl); library(here); library(tidyverse) })
## ---- analysis options --------------------------------------------------------------
TISSUE      <- "F"                 # "F" foot (default) or "G" gill
HI_CONF_ONLY <- FALSE             # TRUE = keep only confident blast annotations (pident>=40 & evalue<1e-10)
KEEP_CATEGORIES <- c("byssal_structural","byssal_accessory","collagen",
"crosslink_curing","collagen_biosynth","ecm_adhesion")
USE_RAW_THREAD_SET <- FALSE        # FALSE = mussels in the curated summary; TRUE = any extracted trace (manifest)
MIN_COUNT <- 5                     # gene kept if count > MIN_COUNT in >= 1/3 of thread-having samples
## ---- portable paths ----------------------------------------------------------------
find_repo_root <- function(start = here::here()) {
d <- normalizePath(start, winslash = "/")
for (i in 1:6) {
if (all(dir.exists(file.path(d, c("differential-expression", "thread-strength"))))) return(d)
d <- dirname(d)
}
stop("Repo root not found: need a parent containing differential-expression/ and thread-strength/.")
}
repo_root    <- find_repo_root()
DE_DIR       <- file.path(repo_root, "differential-expression")
THREAD_FILE  <- file.path(repo_root, "thread-strength", "03_analyses", "thread-summary.xlsx")
EXPR_DIR     <- file.path(repo_root, "gene-mechanics-correlation", "03_analyses", "expr_tables")  # script 22 outputs
LOC_GO_FILE  <- file.path(repo_root, "blast", "03_analyses", "genome-foot", "LOC_GO_list.txt")
OUT_DIR      <- file.path(repo_root, "gene-mechanics-correlation", "03_analyses", "byssus_genes")
dir.create(OUT_DIR, showWarnings = FALSE, recursive = TRUE)
ann <- read_delim(LOC_GO_FILE, delim = "\t",
show_col_types = FALSE) %>%
mutate(LOC_ID = str_extract(as.character(gene), "LOC\\d+")) %>%
filter(!is.na(LOC_ID)) %>%
mutate(across(c(pident, evalue, bitscore), as.numeric)) %>%
arrange(desc(bitscore)) %>% distinct(LOC_ID, .keep_all = TRUE)   # best hit per LOC
PN <- replace_na(ann$`Protein.names`, "")
g  <- function(rx, x = PN) grepl(rx, x, ignore.case = TRUE, perl = TRUE)
category <- dplyr::case_when(
g("foot protein|adhesive plaque|polyphenolic|byssal protein-?\\d|\\bMGFP|\\bMCFP|Mefp|byssal EP|\\bACDC\\b|mussel byssus|mussel adhesive|preCol") ~ "byssal_structural",
g("byssal peroxidase|peroxidasin|\\btyrosinase|catechol oxidase|lysyl oxidase|transglutaminase|gamma-glutamyltransferase|DOPA decarboxylase|aromatic-L-amino-acid decarboxylase|tyrosine decarboxylase") &
!g("glutathione|thioredoxin|peroxiredoxin|monoamine|diamine|polyamine|spermine|histone demethylase|renalase|chloride intracellular|lysine-specific") ~ "crosslink_curing",
g("prolyl 4-hydroxylase|prolyl 3-hydroxylase|lysyl hydroxylase|procollagen-lysine|procollagen-proline|protein disulfide-isomerase") ~ "collagen_biosynth",
g("\\bcollagen\\b|procollagen") ~ "collagen",
g("byssal|byssus") ~ "byssal_accessory",
g("\\bADAMTS|thrombospondin|fibrillin|\\blaminin|von Willebrand factor|fibronectin|matrilin|tenascin|nidogen|perlecan|basement membrane-specific") ~ "ecm_adhesion",
TRUE ~ NA_character_)
byss <- ann %>% mutate(category = category) %>% filter(!is.na(category)) %>%
mutate(hi_conf = pident >= 40 & evalue < 1e-10)
cat("Byssus/foot genes:", nrow(byss), "| high-confidence:", sum(byss$hi_conf, na.rm = TRUE), "\n")
byss %>% dplyr::count(category) %>% as.data.frame() %>% print()
deg_dir <- file.path(DE_DIR, "03_analyses", "DEG_lists", ifelse(TISSUE == "F", "Foot", "Gill"))
add_lfc <- function(tcode) {
f <- list.files(deg_dir, pattern = sprintf("^%s%s_TC_siggene.*\\.csv$", TISSUE, tcode),
full.names = TRUE)
if (!length(f)) return(tibble(LOC_ID = character(), lfc = numeric()))
d <- read.table(f[1], header = TRUE, sep = " ")
gcol <- grep("gene", names(d), ignore.case = TRUE, value = TRUE)[1]
tibble(LOC_ID = sub("^gene-", "", sub(".*\\|", "", sub("^gene-", "", d[[gcol]]))),
lfc = d$log2FoldChange)
}
for (tc in c("OA","OW","DO")) {
lf <- add_lfc(tc) %>% distinct(LOC_ID, .keep_all = TRUE)
byss[[paste0(TISSUE, "_", tc, "_log2FC")]] <- round(lf$lfc[match(byss$LOC_ID, lf$LOC_ID)], 2)
}
byss$n_DE <- rowSums(!is.na(byss[, grep("_log2FC$", names(byss))]))
## thread-having mussel set: from script 22's reconciliation handoff (run 22 first)
man_path <- file.path(EXPR_DIR, "rna_thread_manifest.csv")
if (!file.exists(man_path))
stop("rna_thread_manifest.csv not found in ", EXPR_DIR, " - run script 22 first.")
manifest <- read_csv(man_path, show_col_types = FALSE)
thread_mussels <- if (USE_RAW_THREAD_SET) {
manifest %>% filter(raw_post > 0 | raw_pre > 0) %>% pull(mussel)
} else {
manifest %>% filter(in_summary_post > 0 | in_summary_base > 0) %>% pull(mussel)
}
thread_mussels <- unique(thread_mussels)
## per-mussel day-3 thread mechanics for the companion table (the curated summary)
norm_id <- function(x) {
x   <- as.character(x)
pre <- gsub("[0-9].*$", "", x)
num <- suppressWarnings(as.integer(gsub("[^0-9].*$", "", gsub("^[^0-9]+", "", x))))
ifelse(is.na(num), NA_character_, sprintf("%s%03d", pre, num))
}
read_thread_summary <- function(path) {
d <- readxl::read_excel(path, sheet = "data")
ren <- c(mussel_ID = "mussel", thread_num = "thread", treatment = "thread_trt")
for (from in names(ren)) {
to <- ren[[from]]
if (from %in% names(d) && !to %in% names(d)) names(d)[names(d) == from] <- to
}
if (!"phase" %in% names(d))
d$phase <- dplyr::case_when(d$thread_trt == "lab_control" ~ "lab",
d$thread_trt == "baseline"    ~ "pre",
TRUE                          ~ "post")
if (!"max_displacement" %in% names(d)) d$max_displacement <- NA_real_
d %>% mutate(mussel = norm_id(mussel), adhesion_kpa = max_force / pad_area * 1000) %>%
filter(!is.na(adhesion_kpa))
}
thr_raw <- read_thread_summary(THREAD_FILE)
samples_wanted <- paste0(thread_mussels, TISSUE)
cm <- read.csv(file.path(DE_DIR, "02_data", "gene_count_matrix_clean.csv"),
row.names = 1, check.names = FALSE)
tissue_cols <- if (TISSUE=="F") grep("F$", colnames(cm), value=TRUE) else grep("G$", colnames(cm), value=TRUE)
dds <- DESeqDataSetFromMatrix(round(as.matrix(cm[, tissue_cols])),
DataFrame(row.names = tissue_cols), design = ~ 1)
dds <- dds[rowSums(counts(dds)) > 0, ]
vmat <- assay(vst(dds, blind = TRUE))
rownames(vmat) <- sub("^gene-", "", sub(".*\\|", "", sub("^gene-", "", rownames(vmat))))
samples_have <- intersect(samples_wanted, colnames(vmat))
counts_named <- counts(dds); rownames(counts_named) <- rownames(vmat)
cat("Thread-having mussels:", length(thread_mussels), "| with", TISSUE, "expression:",
length(samples_have), "\n")
genes <- byss
if (HI_CONF_ONLY)       genes <- filter(genes, hi_conf)
genes <- filter(genes, category %in% KEEP_CATEGORIES, LOC_ID %in% rownames(vmat))
## keep genes actually expressed in the thread-having samples
cmat <- counts_named[genes$LOC_ID, samples_have, drop = FALSE]
expressed <- rowSums(cmat > MIN_COUNT) >= ceiling(length(samples_have)/3)
genes <- genes[expressed, ]
cat("Byssus genes expressed in", TISSUE, "across thread-having mussels:", nrow(genes), "\n")
expr_block <- as.data.frame(round(vmat[genes$LOC_ID, samples_have, drop = FALSE], 3))
table_out <- genes %>%
transmute(category, LOC_ID, protein_name = `Protein.names`, gene_name = `Gene.Names`,
pident = round(pident,1), evalue, hi_conf,
!!!set_names(map(grep("_log2FC$", names(genes), value = TRUE),
~ genes[[.x]]), grep("_log2FC$", names(genes), value = TRUE)),
n_DE) %>%
bind_cols(expr_block) %>%
arrange(factor(category, levels = KEEP_CATEGORIES), desc(n_DE), protein_name)
write_csv(table_out, file.path(OUT_DIR, sprintf("byssus_gene_expression_%s.csv", TISSUE)))
## companion: per-mussel treatment + thread mechanics
mech <- thr_raw %>% filter(phase == "post") %>%
group_by(mussel) %>% summarise(treatment = dplyr::first(mussel_trt), n_plaques = n(),
max_force = round(mean(max_force, na.rm=TRUE),3),
pad_area = round(mean(pad_area, na.rm=TRUE),2),
adhesion_kpa = round(mean(adhesion_kpa, na.rm=TRUE),1),
max_displacement = round(mean(max_displacement, na.rm=TRUE),3), .groups="drop")
sample_meta <- tibble(sample = samples_have, mussel = sub(paste0(TISSUE,"$"),"",samples_have)) %>%
left_join(mech, by = "mussel")
write_csv(sample_meta, file.path(OUT_DIR, sprintf("sample_metadata_%s.csv", TISSUE)))
cat("\nGene counts in final table by category:\n")
table_out %>% dplyr::count(category) %>% as.data.frame() %>% print()
cat("\nByssus genes that respond to stress (n_DE>0):\n")
table_out %>% filter(n_DE > 0) %>%
select(category, protein_name, ends_with("_log2FC")) %>% as.data.frame() %>% print()
cat_score <- map_dfr(unique(genes$category), function(cc) {
locs <- genes$LOC_ID[genes$category == cc]
if (length(locs) < 2) return(NULL)
tibble(category = cc, sample = samples_have,
mean_vst = colMeans(vmat[locs, samples_have, drop = FALSE]))
}) %>%
pivot_wider(names_from = category, values_from = mean_vst) %>%
mutate(mussel = sub(paste0(TISSUE,"$"), "", sample)) %>%
left_join(mech, by = "mussel")
write_csv(cat_score, file.path(OUT_DIR, sprintf("byssus_category_scores_%s.csv", TISSUE)))
cat("Wrote per-category mean-expression scores (", ncol(cat_score), "cols ).\n")
cat("
**Outputs (", OUT_DIR, "):**
- `byssus_gene_expression_<tissue>.csv` - the narrowed list: category, protein, blast
quality (pident/evalue/hi_conf), per-contrast log2FC, n_DE, then VST expression across
every thread-having mussel (columns like `T046F` = mussel `T046`).
- `sample_metadata_<tissue>.csv` - per mussel: treatment and post-stress thread mechanics,
to align against the expression columns.
- `byssus_category_scores_<tissue>.csv` - mean VST per category per mussel + mechanics.
**Interpretation / caveats:**
- Categories were built from UniProt names + a tight enzyme filter; `hi_conf` flags
confident blast hits (pident>=40, evalue<1e-10). Set `HI_CONF_ONLY=TRUE` to drop weak
annotations (e.g. distant paralog hits among the many byssal-protein gene copies).
- Byssal proteins are a highly duplicated gene family, so one protein name maps to many
LOCs; that is real, not a bug, but treat the paralog set with care.
- In foot, the canonical *structural* byssal proteins are not differentially expressed; the
stress signal sits in the curing/biosynthesis machinery (prolyl-4-hydroxylase, byssal
HSP-like, transglutaminase). The table lets you confirm this per gene per animal.
- Columns are limited to mussels in the curated summary; set `USE_RAW_THREAD_SET=TRUE`
to include every animal with an extracted trace (script 22 manifest).
")
knitr::opts_chunk$set(echo = TRUE, message = TRUE, warning = TRUE)
suppressPackageStartupMessages(library(here))
code_dir <- here::here("01_code")
html_dir <- here::here("03_analyses", "knit_html")
dir.create(html_dir, showWarnings = FALSE, recursive = TRUE)
script_files <- c(
`20` = "20-gene_mechanics_correlation.Rmd",
`21` = "21-gene_mechanics_expanded.Rmd",
`22` = "22-rna_thread_manifest_and_expression_tables.Rmd",
`23` = "23-byssus_foot_gene_list_expression.Rmd"
)
tissues <- toupper(params$tissues)
scripts <- script_files[as.character(params$scripts)]
stopifnot(all(tissues %in% c("F", "G")), all(!is.na(scripts)))
## Each script is rendered in its OWN R process. Calling rmarkdown::render() from inside a
## knit does not work (the child's `setup` chunk collides with this document's in knitr's
## label registry), and a fresh process is anyway the faithful equivalent of knitting each
## script by hand: nothing leaks between scripts or between tissues.
rscript <- file.path(R.home("bin"), if (.Platform$OS.type == "windows") "Rscript.exe" else "Rscript")
render_in_new_process <- function(rmd, tissue, out_html, log_file) {
job <- tempfile(fileext = ".R")
writeLines(sprintf(
'rmarkdown::render(%s, params = list(tissue = %s), output_file = %s, output_dir = %s, quiet = TRUE)',
shQuote(normalizePath(rmd, winslash = "/")), shQuote(tissue),
shQuote(out_html), shQuote(normalizePath(html_dir, winslash = "/"))), job)
status <- system2(rscript, shQuote(job), stdout = log_file, stderr = log_file)
unlink(job)
status == 0
}
log <- list()
for (tissue in tissues) {
for (s in scripts) {
stem <- tools::file_path_sans_ext(s)
out  <- sprintf("%s_%s.html", stem, tissue)
logf <- file.path(html_dir, sprintf("%s_%s.log", stem, tissue))
message(sprintf("==== %s  tissue = %s ====", s, tissue))
t0 <- Sys.time()
ok <- render_in_new_process(file.path(code_dir, s), tissue, out, logf)
if (!ok) message("FAILED; see ", logf)
log[[length(log) + 1]] <- data.frame(
tissue = tissue, script = s, ok = ok,
minutes = round(as.numeric(difftime(Sys.time(), t0, units = "mins")), 1),
html = if (ok) file.path("03_analyses", "knit_html", out) else NA_character_)
if (!ok) { message("Stopping the ", tissue, " chain; later scripts depend on this one."); break }
}
}
run_log <- do.call(rbind, log)
print(run_log)
write.csv(run_log, file.path(html_dir, "run_log.csv"), row.names = FALSE)
knitr::opts_chunk$set(echo = TRUE, message = TRUE, warning = TRUE)
suppressPackageStartupMessages(library(here))
code_dir <- here::here("01_code")
html_dir <- here::here("03_analyses", "knit_html")
dir.create(html_dir, showWarnings = FALSE, recursive = TRUE)
script_files <- c(
`20` = "20-gene_mechanics_correlation.Rmd",
`21` = "21-gene_mechanics_expanded.Rmd",
`22` = "22-rna_thread_manifest_and_expression_tables.Rmd",
`23` = "23-byssus_foot_gene_list_expression.Rmd"
)
tissues <- toupper(params$tissues)
scripts <- script_files[as.character(params$scripts)]
stopifnot(all(tissues %in% c("F", "G")), all(!is.na(scripts)))

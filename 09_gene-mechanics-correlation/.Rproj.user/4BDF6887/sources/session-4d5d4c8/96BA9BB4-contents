# 2. Define the "mussels with thread data" sample set

```{r threadset}
if (USE_RAW_THREAD_SET) {
  thread_mussels <- manifest %>% filter(raw_post > 0 | raw_pre > 0) %>% pull(mussel)
} else {
  thread_mussels <- unique(thr_raw$mussel)            # present in the curated summary
}
samples_wanted <- paste0(thread_mussels, TISSUE)

## per-mussel thread mechanics (day-3 means, all four arms) for cross-reference
mech <- thr_raw %>%
  filter(phase == "post") %>%
  group_by(mussel, treatment = mussel_trt) %>%
  summarise(n_plaques        = n(),
            max_force        = mean(max_force,        na.rm = TRUE),
            pad_area         = mean(pad_area,         na.rm = TRUE),
            adhesion_kpa     = mean(adhesion_kpa,     na.rm = TRUE),
            max_displacement = mean(max_displacement, na.rm = TRUE), .groups = "drop")
```


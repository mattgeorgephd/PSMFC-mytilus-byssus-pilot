# RStudio per-user state and R session files
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Rendered reports and logs written by the batch runners (every 00_run_*.Rmd and the
# repository-level 00_run_pipeline.Rmd); regenerable
knit_html/

# Fitted DESeq2 objects written by 06_differential-expression/01_code/03_deseq_contrasts.Rmd;
# rebuilt on every run and read by script 04 (the folder's README is kept)
06_differential-expression/03_analyses/dds/*.rds

# OS and Office lock files
.DS_Store
Thumbs.db
~$*

# Alignment intermediates written by 05_sequence-alignment/01_code/01_hisat_stringtie.Rmd (HPC);
# too large for GitHub. The per-sample StringTie folders hold each sample's GTF and .ctab tables.

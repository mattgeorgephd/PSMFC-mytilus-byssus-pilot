knitr::opts_chunk$set(echo = TRUE, message = TRUE, warning = TRUE)
suppressPackageStartupMessages(library(here))
code_dir <- here::here("01_code")
html_dir <- here::here("03_analyses", "knit_html")
dir.create(html_dir, showWarnings = FALSE, recursive = TRUE)
script_files <- c(
`01_7`       = "01_7-secretion_state.Rmd",
`03_5`       = "03_5-DEG_table_provenance_check.Rmd",
`02_6`       = "02_6-DESeq_fourlevel_sensitivity.Rmd",
`02_7`       = "02_7-DESeq_foot_TC_secretion_sensitivity.Rmd",
`04`         = "04-File_joining.Rmd",
`16`         = "16-top_DEGs.Rmd",
`12_venn`    = "12-DEG_venn.Rmd",
`12_volcano` = "12-Volcano-plots.Rmd",
`15`         = "15-number_DEGS.Rmd",
`19`         = "19-DEG_list_cleanup.Rmd"
)
## per-step knit parameters
step_params <- list(`03_5` = list(rewrite_stale = isTRUE(params$rewrite_stale), families = c("TC", "LC")))
steps <- as.character(params$steps)
stopifnot(all(steps %in% names(script_files)))
rscript <- file.path(R.home("bin"), if (.Platform$OS.type == "windows") "Rscript.exe" else "Rscript")
render_in_new_process <- function(rmd, prm, out_html, log_file) {
job <- tempfile(fileext = ".R")
prm_txt <- if (length(prm)) paste0("params = ", paste(deparse(prm), collapse = ""), ", ") else ""
writeLines(sprintf('rmarkdown::render(%s, %soutput_file = %s, output_dir = %s, quiet = TRUE)',
shQuote(normalizePath(rmd, winslash = "/")), prm_txt,
shQuote(out_html), shQuote(normalizePath(html_dir, winslash = "/"))), job)
status <- system2(rscript, shQuote(job), stdout = log_file, stderr = log_file)
unlink(job)
status == 0
}
log <- list()
for (s in steps) {
rmd  <- script_files[[s]]
stem <- tools::file_path_sans_ext(rmd)
logf <- file.path(html_dir, paste0(stem, ".log"))
message(sprintf("==== %s  (%s) ====", s, rmd))
t0 <- Sys.time()
ok <- render_in_new_process(file.path(code_dir, rmd), step_params[[s]], paste0(stem, ".html"), logf)
if (!ok) message("FAILED; see ", logf)
log[[length(log) + 1]] <- data.frame(
step = s, script = rmd, ok = ok,
minutes = round(as.numeric(difftime(Sys.time(), t0, units = "mins")), 1),
html = if (ok) file.path("03_analyses", "knit_html", paste0(stem, ".html")) else NA_character_)
if (!ok && isTRUE(params$stop_on_fail)) { message("Stopping the batch (stop_on_fail = TRUE)."); break }
}
run_log <- do.call(rbind, log)
print(run_log)
write.csv(run_log, file.path(html_dir, "run_log.csv"), row.names = FALSE)
knitr::opts_chunk$set(echo = TRUE, message = FALSE, warning = FALSE)
source(here::here("01_code", "_paths.R"))
suppressPackageStartupMessages({ library(DESeq2); library(apeglm); library(tidyverse) })
REWRITE_STALE <- isTRUE(params$rewrite_stale)
FAMILIES      <- if (!is.null(params$families)) params$families else "TC"
PADJ_CUTOFF   <- 0.05
tc <- tribble(
~code,  ~dir,   ~trt,  ~full_table,          ~siggene,
"FOA",  "Foot", "OA",  "FOA_TC_apeglm.csv",  "FOA_TC_siggene.csv",
"FOW",  "Foot", "OW",  "FOW_TC_apeglm.csv",  "FOW_TC_siggene.csv",
"FDO",  "Foot", "DO",  "FDO_TC_apeglm.csv",  "FDO_TC_siggene_apeglm.csv",
"GOA",  "Gill", "OA",  "GOA_TC.csv",         "GOA_TC_siggene.csv",
"GOW",  "Gill", "OW",  "GOW_TC_apeglm.csv",  "GOW_TC_siggene_apeglm.csv",
"GDO",  "Gill", "DO",  "GDO_TC_apeglm.csv",  "GDO_TC_siggene_apeglm.csv"
) %>% mutate(family = "TC", design_var = "treatment", ref_level = "control",
countmatrix   = sprintf("%s_TC_countmatrix.csv", code),
treatmentinfo = sprintf("%s_TC_treatmentinfo.csv", code),
reference = "day-3 treatment control")
## LC: stressor (or day-3 control) vs the day-0 lab control. In the *TC_LC files both groups
## carry treatment == "control", so the design is ~ day (levels 0, 3) and the coefficient
## is day_3_vs_0; elsewhere it is ~ treatment with control = day 0.
lc <- tribble(
~code,     ~dir,   ~trt,      ~design_var,  ~ref_level,
"FOA_LC",  "Foot", "OA",      "treatment",  "control",
"FOW_LC",  "Foot", "OW",      "treatment",  "control",
"FDO_LC",  "Foot", "DO",      "treatment",  "control",
"FTC_LC",  "Foot", "3",       "day",        "0",
"GOA_LC",  "Gill", "OA",      "treatment",  "control",
"GOW_LC",  "Gill", "OW",      "treatment",  "control",
"GDO_LC",  "Gill", "DO",      "treatment",  "control",
"GTC_LC",  "Gill", "3",       "day",        "0"
) %>% mutate(family = "LC",
full_table    = sprintf("%s_apeglm.csv", code),
siggene       = sprintf("%s_siggene.csv", code),
countmatrix   = sprintf("%s_countmatrix.csv", code),
treatmentinfo = sprintf("%s_treatmentinfo.csv", code),
reference = "day-0 lab control")
contrasts <- bind_rows(tc, lc) %>% filter(family %in% FAMILIES)
knitr::kable(contrasts %>% select(code, family, dir, trt, design_var, ref_level, full_table, siggene, reference))
master <- as.matrix(read.csv(file.path(dat, "gene_count_matrix_clean.csv"),
row.names = 1, check.names = FALSE))
cat("Master count matrix:", nrow(master), "genes x", ncol(master), "samples\n")
read_countmatrix <- function(path) {
first <- readLines(path, n = 1)
m <- if (grepl(",", first, fixed = TRUE))
read.csv(path, row.names = 1, check.names = FALSE)
else read.table(path, header = TRUE, sep = " ", row.names = 1, check.names = FALSE)
as.matrix(m)
}
read_treatmentinfo <- function(path) {
d <- read.table(path, header = TRUE, sep = " ", stringsAsFactors = FALSE)
if (!"sample.1" %in% names(d)) stop("no `sample.1` column in ", path)
d <- d[, c("sample.1", "tissue", "treatment", "day")]
rownames(d) <- d$sample.1
d
}
read_results <- function(path) read.table(path, header = TRUE, sep = " ", stringsAsFactors = FALSE)
rederive <- function(row) {
d  <- file.path(deg, row$dir)
ti <- read_treatmentinfo(file.path(d, row$treatmentinfo))
missing <- setdiff(ti$sample.1, colnames(master))
if (length(missing) > 0)
stop(row$code, ": sample(s) in treatmentinfo but not in the master matrix: ",
paste(missing, collapse = ", "))
cm <- master[, ti$sample.1, drop = FALSE]                    # what 02_5 does
## explicit reference level, whichever variable the contrast is on (treatment or day)
ti[[row$design_var]] <- factor(as.character(ti[[row$design_var]]), levels = c(row$ref_level, row$trt))
stopifnot(!anyNA(ti[[row$design_var]]), nlevels(droplevels(ti[[row$design_var]])) == 2)
## does the committed per-contrast matrix hold the same counts? (row names may be lost)
disk <- read_countmatrix(file.path(d, row$countmatrix))
cm_ok <- identical(dim(disk), dim(cm)) && identical(colnames(disk), colnames(cm)) &&
isTRUE(all.equal(unname(disk), unname(cm), check.attributes = FALSE))
cm_ids_lost <- !identical(rownames(disk), rownames(cm))
dds  <- DESeqDataSetFromMatrix(cm, ti, reformulate(row$design_var))
dds  <- DESeq(dds, quiet = TRUE)
keep <- rowSums(counts(dds) >= 10) >= ncol(cm) / 3          # same filter as 02_5
ddsf <- dds[keep, ]
coefn <- sprintf("%s_%s_vs_%s", row$design_var, row$trt, row$ref_level)
stopifnot(resultsNames(ddsf)[2] == coefn)
res  <- lfcShrink(ddsf, coef = 2, type = "apeglm", quiet = TRUE)
full <- data.frame(gene = rownames(res), as.data.frame(res), row.names = NULL)
sig  <- full %>% filter(!is.na(padj), padj < PADJ_CUTOFF)
list(full = full, sig = sig, n_samples = ncol(cm), n_kept = sum(keep),
countmatrix_matches_master = cm_ok, countmatrix_gene_ids_lost = cm_ids_lost)
}
compare_tables <- function(new, old, label) {
shared <- intersect(new$gene, old$gene)
m <- inner_join(new, old, by = "gene", suffix = c("_new", "_old"))
tibble(
!!paste0(label, "_rows_disk")   := nrow(old),
!!paste0(label, "_rows_new")    := nrow(new),
!!paste0(label, "_same_genes")  := setequal(new$gene, old$gene),
!!paste0(label, "_baseMean_maxrel") := signif(max(abs(m$baseMean_new - m$baseMean_old) / m$baseMean_old), 3),
!!paste0(label, "_lfc_maxabs")  := signif(max(abs(m$log2FoldChange_new - m$log2FoldChange_old)), 3),
!!paste0(label, "_padj_maxabs") := signif(max(abs(m$padj_new - m$padj_old), na.rm = TRUE), 3)
)
}
results <- vector("list", nrow(contrasts))
for (i in seq_len(nrow(contrasts))) {
row <- contrasts[i, ]
d   <- file.path(deg, row$dir)
cat("\n==", row$code, "==\n")
rd  <- rederive(row)
old_full <- read_results(file.path(d, row$full_table))
old_sig  <- read_results(file.path(d, row$siggene))
cmp_full <- compare_tables(rd$full, old_full, "full")
cmp_sig  <- compare_tables(rd$sig,  old_sig,  "siggene")
## "consistent" = same gene universe and values agree to numerical noise (baseMean is
## version-stable; log2FC and padj can drift slightly between DESeq2/apeglm releases)
full_ok <- cmp_full$full_same_genes && cmp_full$full_baseMean_maxrel < 1e-6
sig_ok  <- cmp_sig$siggene_same_genes && cmp_sig$siggene_baseMean_maxrel < 1e-6
results[[i]] <- bind_cols(
tibble(code = row$code, family = row$family, tissue = row$dir, treatment = row$trt,
reference = row$reference, design = paste0("~ ", row$design_var),
n_samples = rd$n_samples, genes_after_filter = rd$n_kept,
n_DEG_rederived = nrow(rd$sig),
countmatrix_matches_master = rd$countmatrix_matches_master,
countmatrix_gene_ids_lost  = rd$countmatrix_gene_ids_lost),
cmp_full, cmp_sig,
tibble(full_table_consistent = full_ok, siggene_consistent = sig_ok,
full_table_file = row$full_table, siggene_file = row$siggene))
cat(sprintf("samples %d | genes after filter %d | DEGs %d | count matrix %s | full table %s | DEG list %s\n",
rd$n_samples, rd$n_kept, nrow(rd$sig),
ifelse(rd$countmatrix_matches_master, "matches master", "DIFFERS from master"),
ifelse(full_ok, "consistent", "STALE"), ifelse(sig_ok, "consistent", "STALE")))
results[[i]]$rewritten_this_run <- FALSE
if (REWRITE_STALE) {
if (!full_ok) {
write.table(rd$full, file.path(d, row$full_table), row.names = FALSE)
cat("  rewrote", row$full_table, "\n")
}
if (!sig_ok) {
write.table(rd$sig, file.path(d, row$siggene), row.names = FALSE)
cat("  rewrote", row$siggene, "\n")
}
results[[i]]$rewritten_this_run <- !full_ok || !sig_ok
}
}
check <- bind_rows(results)
## keep the rows of any family that was not re-run this time, so the file stays complete
prev_file <- file.path(deg, "DEG_provenance_check.csv")
if (file.exists(prev_file) && !all(c("TC", "LC") %in% FAMILIES)) {
prev <- read_csv(prev_file, show_col_types = FALSE)
if (!"family" %in% names(prev)) prev$family <- "TC"      # files written before the LC rows existed
check <- bind_rows(check, prev %>% filter(!family %in% FAMILIES))
}
write_csv(check, prev_file)
check %>%
select(code, family, n_samples, genes_after_filter, n_DEG_rederived, countmatrix_matches_master,
full_rows_disk, full_same_genes, full_baseMean_maxrel, full_table_consistent,
siggene_rows_disk, siggene_same_genes, siggene_baseMean_maxrel, siggene_consistent) %>%
knitr::kable()
cat(if (REWRITE_STALE) "\nStale files were rewritten (params$rewrite_stale = TRUE); re-run 04-File_joining.Rmd next.\n"
else "\nCheck only (params$rewrite_stale = FALSE). Knit with rewrite_stale = TRUE to overwrite stale files.\n")
knitr::opts_chunk$set(echo = TRUE, message = FALSE, warning = FALSE)
source(here::here("01_code", "_paths.R"))
suppressPackageStartupMessages({ library(DESeq2); library(apeglm); library(tidyverse) })
OUT <- file.path(deg, "sensitivity_fourlevel")
dir.create(OUT, showWarnings = FALSE, recursive = TRUE)
PADJ_CUTOFF <- 0.05
ARMS <- c("control", "OA", "OW", "DO")          # reference first: coefficient names depend on it
master <- as.matrix(read.csv(file.path(dat, "gene_count_matrix_clean.csv"),
row.names = 1, check.names = FALSE))
ti <- read.csv(file.path(dat, "treatmentinfo_clean.csv"), row.names = 1, stringsAsFactors = FALSE)
cat("Master count matrix:", nrow(master), "genes x", ncol(master), "samples\n")
## the primary DEG lists, for the comparison
primary_siggene <- function(tissue, trt) {
d <- file.path(deg, ifelse(tissue == "F", "Foot", "Gill"))
f <- list.files(d, pattern = sprintf("^%s%s_TC_siggene.*\\.csv$", tissue, trt), full.names = TRUE)
if (!length(f)) return(character(0))
read.table(f[1], header = TRUE, sep = " ", stringsAsFactors = FALSE)$gene
}
fit_tissue <- function(tissue) {
cd <- ti %>% filter(tissue == !!tissue, day == 3, treatment %in% ARMS)
cd <- cd[cd$sample.1 %in% colnames(master), ]
cd$treatment <- factor(cd$treatment, levels = ARMS)          # explicit reference level
rownames(cd) <- cd$sample.1
cm <- master[, cd$sample.1, drop = FALSE]
cat(sprintf("\n== %s: %d samples (%s)\n", tissue, ncol(cm),
paste(sprintf("%s %d", names(table(cd$treatment)), as.integer(table(cd$treatment))), collapse = ", ")))
dds <- DESeqDataSetFromMatrix(cm, cd, ~ treatment)
dds <- DESeq(dds, quiet = TRUE)
keep <- rowSums(counts(dds) >= 10) >= ncol(cm) / 3            # same filter as 02_5, all arms
ddsf <- dds[keep, ]
stopifnot(resultsNames(ddsf)[1] == "Intercept",
all(sprintf("treatment_%s_vs_control", ARMS[-1]) %in% resultsNames(ddsf)))
res <- map(ARMS[-1], function(trt) {
coefn <- sprintf("treatment_%s_vs_control", trt)
r <- lfcShrink(ddsf, coef = coefn, type = "apeglm", quiet = TRUE)
full <- data.frame(gene = rownames(r), as.data.frame(r), row.names = NULL)
sig  <- full %>% filter(!is.na(padj), padj < PADJ_CUTOFF)
code <- paste0(tissue, trt)
write.table(full, file.path(OUT, sprintf("%s_TC4_apeglm.csv", code)),  row.names = FALSE)
write.table(sig,  file.path(OUT, sprintf("%s_TC4_siggene.csv", code)), row.names = FALSE)
prim <- primary_siggene(tissue, trt)
tibble(code = code, tissue = tissue, treatment = trt, n_samples_fit = ncol(cm),
genes_after_filter = sum(keep),
n_DEG_fourlevel = nrow(sig), n_DEG_primary_pairwise = length(prim),
n_shared = length(intersect(sig$gene, prim)),
n_only_fourlevel = length(setdiff(sig$gene, prim)),
n_only_pairwise  = length(setdiff(prim, sig$gene)),
jaccard = ifelse(length(union(sig$gene, prim)) > 0,
length(intersect(sig$gene, prim)) / length(union(sig$gene, prim)), NA_real_),
n_up_fourlevel = sum(sig$log2FoldChange > 0), n_down_fourlevel = sum(sig$log2FoldChange < 0))
}) %>% bind_rows()
## which genes changed status, with both padj values, for the reader who wants to look
print(as.data.frame(res))
res
}
cmp <- bind_rows(fit_tissue("F"), fit_tissue("G"))
write_csv(cmp, file.path(OUT, "fourlevel_vs_pairwise_DEG_counts.csv"))
knitr::kable(cmp)
writeLines(c(paste0("generated : ", format(Sys.time(), "%Y-%m-%d %H:%M:%S")),
"design    : ~ treatment, levels control, OA, OW, DO (one fit per tissue, day-3 samples)",
"filter    : >= 10 counts in >= 1/3 of the tissue's day-3 samples",
"shrinkage : apeglm, coef = treatment_<X>_vs_control",
paste0("padj      : < ", PADJ_CUTOFF),
paste0("R / DESeq2 / apeglm : ", R.version.string, " / ", as.character(packageVersion("DESeq2")),
" / ", as.character(packageVersion("apeglm")))),
file.path(OUT, "RUN_provenance.txt"))
source(here::here("01_code", "_paths.R"))
suppressPackageStartupMessages({ library(tidyverse); library(stringr) })
# Output of blastx + UniProt + GO, one row per (transcript, hit)
masterID <- read.delim(file.path(blast_go, "LOC_GO_list.txt"), sep = "\t", header = TRUE)
# Drop the three trailing helper columns (V11, V2.x, uniprot_accession.y)
masterID <- masterID[, -((ncol(masterID) - 2):ncol(masterID))]
colnames(masterID) <- c("transcript", "database", "uniprot_accession", "geneID", "species",
"pident", "length", "mismatch", "gapopen", "qstart", "qend", "sstart",
"send", "evalue", "bitscore", "reviewed", "entryname", "protein_name",
"gene_name", "organism", "prot_length", "GO_ID", "GO_BP", "GO_MF",
"GO_CC", "Genename_orderedlocus", "Induction", "Pathwaycommons",
"Reactome", "Unipathway", "Interacts_with", "LOC_ID")
masterID$LOC_ID[masterID$LOC_ID == ""] <- NA
cat("Master table:", nrow(masterID), "rows;", sum(is.na(masterID$LOC_ID)), "with no key;",
dplyr::n_distinct(na.omit(masterID$LOC_ID)), "distinct keys\n")
# Join key for a count-matrix gene name: the LOC identifier when there is one, otherwise the
# gene symbol between "gene-" and "|" (mitochondrial genes). NA only if neither parses.
deg_key <- function(gene) {
loc <- str_extract(gene, "LOC\\d+")
sym <- str_match(gene, "^gene-([^|]+)\\|")[, 2]
dplyr::coalesce(loc, sym)
}
is_mito <- function(key) !grepl("^LOC\\d+$", key)
contrasts <- tribble(
~code,  ~dir,   ~siggene,
"FDO",  "Foot", "FDO_TC_siggene_apeglm.csv",
"GDO",  "Gill", "GDO_TC_siggene_apeglm.csv",
"FOA",  "Foot", "FOA_TC_siggene.csv",
"GOA",  "Gill", "GOA_TC_siggene.csv",
"FOW",  "Foot", "FOW_TC_siggene.csv",
"GOW",  "Gill", "GOW_TC_siggene_apeglm.csv"
)
out_dir <- file.path(deg, "GOterms_genome")
dir.create(out_dir, showWarnings = FALSE)
join_contrast <- function(code, dir, siggene) {
sig <- read.delim(file.path(deg, dir, siggene), sep = " ", header = TRUE) %>%
mutate(LOC_ID = deg_key(gene))
if (anyNA(sig$LOC_ID))
stop(code, ": ", sum(is.na(sig$LOC_ID)), " DEG(s) with an unparseable gene name: ",
paste(head(sig$gene[is.na(sig$LOC_ID)]), collapse = ", "))
if (anyDuplicated(sig$gene) > 0)
stop(code, ": duplicated gene names in ", siggene)
merged <- left_join(sig, masterID, by = "LOC_ID", na_matches = "never",
relationship = "many-to-many")
unID <- merged[is.na(merged$geneID), ]
ID   <- merged[!is.na(merged$geneID), ]
write_csv(merged, file.path(out_dir, sprintf("%s_sigs_merged.csv", code)))
write_csv(unID,   file.path(out_dir, sprintf("%s_sigs_unID.csv", code)))
write_csv(ID,     file.path(out_dir, sprintf("%s_sigs_ID.csv", code)))
tibble(code = code, tissue = dir,
n_DEG_genes         = nrow(sig),                       # the number to report
n_merged_rows       = nrow(merged),                    # one row per gene x hit
n_ID_rows           = nrow(ID),
n_unID_rows         = nrow(unID),
n_genes_annotated   = dplyr::n_distinct(ID$gene),
n_genes_unannotated = dplyr::n_distinct(unID$gene),
n_mito_DEGs         = sum(is_mito(sig$LOC_ID)),
mito_DEGs           = paste(sig$LOC_ID[is_mito(sig$LOC_ID)], collapse = ";"))
}
summary_tbl <- pmap_dfr(contrasts, join_contrast)
stopifnot(all(summary_tbl$n_genes_annotated + summary_tbl$n_genes_unannotated == summary_tbl$n_DEG_genes))
write_csv(summary_tbl, file.path(deg, "DEG_join_summary.csv"))
knitr::kable(summary_tbl)
knitr::opts_chunk$set(echo = TRUE, message = TRUE, warning = TRUE)
suppressPackageStartupMessages(library(here))
code_dir <- here::here("01_code")
html_dir <- here::here("03_analyses", "knit_html")
dir.create(html_dir, showWarnings = FALSE, recursive = TRUE)
script_files <- c(
`03_5`       = "03_5-DEG_table_provenance_check.Rmd",
`02_6`       = "02_6-DESeq_fourlevel_sensitivity.Rmd",
`04`         = "04-File_joining.Rmd",
`16`         = "16-top_DEGs.Rmd",
`12_venn`    = "12-DEG_venn.Rmd",
`12_volcano` = "12-Volcano-plots.Rmd",
`15`         = "15-number_DEGS.Rmd",
`19`         = "19-DEG_list_cleanup.Rmd"
)
## per-step knit parameters
step_params <- list(`03_5` = list(rewrite_stale = isTRUE(params$rewrite_stale), families = "TC"))
steps <- as.character(params$steps)
stopifnot(all(steps %in% names(script_files)))
rscript <- file.path(R.home("bin"), if (.Platform$OS.type == "windows") "Rscript.exe" else "Rscript")
render_in_new_process <- function(rmd, prm, out_html, log_file) {
job <- tempfile(fileext = ".R")
prm_txt <- if (length(prm)) paste0("params = ", paste(deparse(prm), collapse = ""), ", ") else ""
writeLines(sprintf('rmarkdown::render(%s, %soutput_file = %s, output_dir = %s, quiet = TRUE)',
shQuote(normalizePath(rmd, winslash = "/")), prm_txt,
shQuote(out_html), shQuote(normalizePath(html_dir, winslash = "/"))), job)
status <- system2(rscript, shQuote(job), stdout = log_file, stderr = log_file)
unlink(job)
status == 0
}
log <- list()
for (s in steps) {
rmd  <- script_files[[s]]
stem <- tools::file_path_sans_ext(rmd)
logf <- file.path(html_dir, paste0(stem, ".log"))
message(sprintf("==== %s  (%s) ====", s, rmd))
t0 <- Sys.time()
ok <- render_in_new_process(file.path(code_dir, rmd), step_params[[s]], paste0(stem, ".html"), logf)
if (!ok) message("FAILED; see ", logf)
log[[length(log) + 1]] <- data.frame(
step = s, script = rmd, ok = ok,
minutes = round(as.numeric(difftime(Sys.time(), t0, units = "mins")), 1),
html = if (ok) file.path("03_analyses", "knit_html", paste0(stem, ".html")) else NA_character_)
if (!ok && isTRUE(params$stop_on_fail)) { message("Stopping the batch (stop_on_fail = TRUE)."); break }
}
run_log <- do.call(rbind, log)
print(run_log)
write.csv(run_log, file.path(html_dir, "run_log.csv"), row.names = FALSE)
## Any failed step fails the driver, after the log is written (with stop_on_fail = FALSE the
## remaining steps still ran), so a partial batch can never look like a complete one.
if (!all(run_log$ok))
stop("Differential-expression step(s) failed: ", paste(run_log$step[!run_log$ok], collapse = ", "),
". See the .log files in ", html_dir, ".")
